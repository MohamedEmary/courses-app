{
  "name": "courses-app-server",
  "version": "1.0.0",
  "description": "A courses REST API built with Express 5, MongoDB (Mongoose), and TypeScript, with JWT access/refresh auth, role-based access control, Zod validation, avatar uploads (Multer), and JSend responses, tested with Vitest and Supertest.",
  "author": "Mohamed Emary",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "docs:link": "node ../bruno/api-docs-fix.js"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "typescript",
    "jwt",
    "authentication",
    "authorization",
    "zod",
    "multer",
    "vitest",
    "supertest"
  ],
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.8.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "multer": "^2.2.0",
    "zod": "^4.4.3"
  }
}
